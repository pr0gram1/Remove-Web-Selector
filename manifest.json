{
    "manifest_version": 3,
    "name": "Reddit Upsell Remover",
    "version": "1.0",
    "description": "Removes the Reddit desktop upsell dialog.",
    "content_scripts": [
        {
            "matches": [
                "https://www.reddit.com/*",
                "https://reddit.com/*"
            ],
            "js": ["content.js"],
            "run_at": "document_start"
        }
    ]
}